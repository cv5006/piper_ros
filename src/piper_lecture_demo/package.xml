<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>piper_lecture_demo</name>
  <version>0.1.0</version>
  <description>
    로보틱스 기초 특강(2회차 「운동 — Jacobian과 Inverse Kinematics」) 시연용 데모 모음.
    로봇 모델과 MoveIt 설정은 만들지 않고 piper_description / piper_with_gripper_moveit 의 것을 쓴다.
  </description>
  <maintainer email="hwiwon@hanwha.com">hwiwon</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- MoveIt 을 얹는 데모 (obstacle · path_compare) -->
  <depend>rclcpp</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>      <!-- jacobian_check 의 RobotModelLoader -->
  <depend>ament_index_cpp</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- URDF 만 읽는 도구 (manipulability · workspace · ik_solutions). 런타임 의존은 rclpy + numpy 뿐 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>          <!-- 실물 어댑터의 액션 -->
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>piper_msgs</exec_depend>            <!-- enable_srv -->
  <exec_depend>piper</exec_depend>                 <!-- 실물 드라이버 노드 -->
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>          <!-- 데모들의 켜고 끄기 서비스 -->
  <exec_depend>tf2_ros</exec_depend>           <!-- manipulability 의 tcp 프레임, tcp_vs_flange 의 TF 읽기 -->
  <exec_depend>moveit_msgs</exec_depend>       <!-- obstacle 의 planning scene -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>   <!-- manipulability 의 2D 숫자판 렌더링 -->
  <exec_depend>python3-pyqt5</exec_depend>    <!-- lecture_panel 의 버튼 창 -->

  <!-- 모델 · MoveIt 설정은 전부 piper 것을 쓴다 -->
  <exec_depend>piper_description</exec_depend>
  <exec_depend>piper_with_gripper_moveit</exec_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
